#!/usr/bin/env python3
"""Guard remote git URLs before delegating to the image's real git binary."""

from __future__ import annotations

import os
import re
import sys
from urllib.parse import urlsplit

from network_policy import MODE, require_allowed_host


SCP_LIKE = re.compile(r"^(?:[^@/:]+@)?([^/:]+):.+$")


def inspect_arg(arg: str) -> None:
    if "://" in arg:
        parsed = urlsplit(arg)
        if parsed.hostname:
            require_allowed_host(parsed.hostname, "git remote access")
        return
    match = SCP_LIKE.match(arg)
    if match and not arg.startswith(("/", "./", "../")):
        require_allowed_host(match.group(1), "git remote access")


def main() -> None:
    if MODE != "online":
        for argument in sys.argv[1:]:
            inspect_arg(argument)
    os.execv("/usr/bin/git", ["git", *sys.argv[1:]])


if __name__ == "__main__":
    main()
