{
  "storage": {
    "workspace": "/app/.openviking/data",
    "vectordb": {
      "name": "context",
      "backend": "local"
    },
    "agfs": {
      "backend": "local"
    }
  },
  "embedding": {
    "max_concurrent": 4,
    "max_retries": 2,
    "dense": {
      "provider": "openai",
      "api_base": "${OPENVIKING_EMBEDDING_API_BASE}",
      "api_key": "${OPENVIKING_EMBEDDING_API_KEY}",
      "model": "${OPENVIKING_EMBEDDING_MODEL}",
      "dimension": 1024,
      "input": "text",
      "encoding_format": "float",
      "batch_size": 16
    }
  },
  "vlm": {
    "provider": "openai",
    "api_base": "${OPENVIKING_VLM_API_BASE}",
    "api_key": "${OPENVIKING_VLM_API_KEY}",
    "model": "${OPENVIKING_VLM_MODEL}",
    "max_concurrent": 4,
    "max_retries": 2,
    "timeout": 600,
    "thinking": false
  },
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "workers": 1,
    "auth_mode": "api_key",
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}",
    "cors_origins": [
      "http://127.0.0.1:1933",
      "http://localhost:1933"
    ],
    "profile_enabled": false,
    "with_bot": false
  },
  "telemetry": {
    "tracer": {
      "enabled": false,
      "endpoint": "",
      "service_name": "openviking-intranet"
    }
  },
  "connector": {
    "enable": false
  },
  "parser_api": {
    "enable": false
  },
  "enable_watch_scheduler": false,
  "default_search_mode": "fast",
  "output_language_override": "zh-CN"
}
