# 容器与监听。默认只绑定 UOS 本机回环地址。
OPENVIKING_IMAGE=openviking-uos:0.4.15-uos.2
OPENVIKING_BIND_ADDRESS=127.0.0.1
OPENVIKING_HOST_PORT=1933
OPENVIKING_DATA_DIR=/var/lib/openviking

# offline 只允许回环；intranet 允许私网 IP，但域名仍必须显式列入允许清单。
OPENVIKING_NETWORK_MODE=intranet
OPENVIKING_ALLOWED_HOSTS=model-gateway.intra.example
OPENVIKING_ALLOWED_CIDRS=

# OpenAI 兼容的企业内网模型网关。不要填写公网服务地址。
OPENVIKING_EMBEDDING_API_BASE=http://model-gateway.intra.example:8000/v1
OPENVIKING_EMBEDDING_API_KEY=replace-with-intranet-embedding-key
OPENVIKING_EMBEDDING_MODEL=bge-m3
OPENVIKING_VLM_API_BASE=http://model-gateway.intra.example:8000/v1
OPENVIKING_VLM_API_KEY=replace-with-intranet-vlm-key
OPENVIKING_VLM_MODEL=qwen3-vl

# 至少 32 个随机字符；生产环境不要复用模型密钥。
OPENVIKING_ROOT_API_KEY=change-me-to-a-random-root-api-key
